#. translators: %s: domain the license is activated for
#: src/Updates.php:137
msgid "The license is activated for the domain %s, not for this site."
msgstr "A licenc a(z) %s domainhez van aktiválva, nem ehhez a webhelyhez."

#: src/Updates.php:138
msgid "The license is activated for a different domain."
msgstr "A licenc egy másik domainhez van aktiválva."

#: src/Updates.php:140
msgid "The license activation was not found. It may have been deactivated in your WPify account."
msgstr "A licenc aktiválása nem található. Lehet, hogy kikapcsolták a WPify-fiókjában."

#: src/Updates.php:143
msgid "The subscription is on hold, waiting for payment."
msgstr "Az előfizetés szünetel, fizetésre vár."

#: src/Updates.php:144
msgid "The subscription is not active."
msgstr "Az előfizetés nem aktív."

#: src/Updates.php:146
msgid "No active subscription was found for this license."
msgstr "Ehhez a licenchez nem található aktív előfizetés."

#: src/Updates.php:148
msgid "The license key is not valid."
msgstr "A licenckulcs nem érvényes."
